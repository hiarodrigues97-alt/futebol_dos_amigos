DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# --- Senha de administrador (OBRIGATÓRIO em produção) ---
# Sem ADMIN_PASSWORD, qualquer pessoa com o link consegue editar os dados.
ADMIN_PASSWORD=troque-esta-senha
# Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 0 = rodando local em http | 1 = produção em https
COOKIE_SEGURO=0
# 1 = atrás de proxy (Render, Railway, Heroku): o limite de tentativas usa o IP real
TRUST_PROXY=0

# Opcionais
# FUSO_HORARIO=America/Sao_Paulo
# SESSAO_DIAS=30
# LOGIN_MAX_TENTATIVAS=5
# LOGIN_BLOQUEIO_SEGUNDOS=300
# IMAGEM_FUNDO=img/fundo-top10.png
